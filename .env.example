APP_ENV=development
APP_BASE_URL=http://localhost:8000
APP_VERSION=0.1.0
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE=
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
API_ACCESS_TOKEN=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

DPR_POSTGRES_DB=distressed_property_radar
DPR_POSTGRES_TEST_DB=distressed_property_radar_test
DPR_POSTGRES_USER=distressed_property_radar
DPR_POSTGRES_PASSWORD=change-me-local-only
DPR_POSTGRES_PORT=55432

DATABASE_URL=postgresql+psycopg://distressed_property_radar:change-me-local-only@localhost:55432/distressed_property_radar
TEST_DATABASE_URL=postgresql+psycopg://distressed_property_radar:change-me-local-only@localhost:55432/distressed_property_radar_test
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5

SCHEDULER_OWNER=worker
STALE_JOB_TIMEOUT_SECONDS=7200
SOURCE_STALE_AFTER_SECONDS=86400
OPERATIONAL_ALERT_COOLDOWN_SECONDS=21600
WORKER_POLL_INTERVAL_SECONDS=300
WORKER_FAST_DISCOVERY_INTERVAL_SECONDS=1800

BACKUP_DIRECTORY=backups
BACKUP_RETENTION_DAYS=14
BACKUP_OFFSERVER_CONFIGURED=false
BACKUP_COMMAND_TIMEOUT_SECONDS=3600
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
PSQL_PATH=psql

RAW_RECORD_RETENTION_DAYS=90

FOUR_ZIDA_TIMEOUT_SECONDS=20
FOUR_ZIDA_RETRY_COUNT=2
FOUR_ZIDA_MIN_REQUEST_DELAY_SECONDS=0.2
FOUR_ZIDA_MAX_CONCURRENCY=1
FOUR_ZIDA_MAX_PAGES_PER_MARKET=1

LLM_API_KEY=
LLM_MODEL=dpr-structured-extractor-v1

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org

VITE_API_BASE_URL=http://localhost:8000
